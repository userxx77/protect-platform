generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FlagLevel {
  CLEAN
  WATCH
  SUSPICIOUS
  HIGH_RISK
  CONFIRMED_CHEATER
}

enum ReportStatus {
  PENDING
  ACCEPTED
  REJECTED
  SPAM
}

enum FlagSource {
  TRUSTED_COMMAND
  COMMUNITY_REPORT
  ADMIN_OVERRIDE
  API
  REPORT_ESCALATION
  SYSTEM
}

enum AuditAction {
  FLAG_CREATED
  FLAG_DELETED
  FLAG_UPDATED
  REPORT_CREATED
  REPORT_APPROVED
  REPORT_REJECTED
  REPORT_REJECTED_ABUSE
  SERVER_CONFIG_UPDATED
  TRUST_GRANTED
  USER_TOUCHED
  ROLE_ASSIGNED
  API_CLIENT_CREATED
  GUILD_DISCOVERED
  ENTITLEMENT_UPDATED
}

enum ActorKind {
  USER
  BOT
  SYSTEM
}

enum PlatformRole {
  CHECKER
  USER
  ADMIN
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DISPATCHED
  FAILED
}

enum LicenseStatus {
  INACTIVE
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}

enum MemberSyncState {
  IDLE
  QUEUED
  RUNNING
  PAUSED
}

enum SupportTicketStatus {
  OPEN
  NEEDS_EVIDENCE
  EVIDENCE_SUBMITTED
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

model User {
  id          String    @id @default(uuid()) @db.Uuid
  discordId   String    @unique @map("discord_id")
  flagScore   Int       @default(0) @map("flag_score")
  flagLevel   FlagLevel @default(CLEAN) @map("flag_level")
  /// Bumped on every aggregate-changing write (flags/score/level); monotonic ordering aid.
  stateVersion Int      @default(0) @map("state_version")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  flags         Flag[]
  reportsAsTarget Report[] @relation("ReportTarget")

  @@map("users")
}

model Flag {
  id              String     @id @default(uuid()) @db.Uuid
  userId          String     @map("user_id") @db.Uuid
  weight          Int
  /// Future decay: when FLAG_DECAY_ENABLED, recompute from effectiveWeight
  effectiveWeight Int?       @map("effective_weight")
  reason          String
  source          FlagSource @default(TRUSTED_COMMAND)
  actorDiscordId  String     @map("actor_discord_id")
  guildId         String?    @map("guild_id")
  createdAt       DateTime   @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  report Report?

  @@index([userId, createdAt(sort: Desc)])
  @@map("flags")
}

model Report {
  id                String       @id @default(uuid()) @db.Uuid
  reporterDiscordId String       @map("reporter_discord_id")
  reportedUserId    String       @map("reported_user_id") @db.Uuid
  guildId           String?      @map("guild_id")
  /** Severity indicated by reporter (slash choice); distinct from aggregate User.flagLevel. */
  allegedFlagLevel  FlagLevel?   @map("alleged_flag_level")
  reason            String
  dedupeKey         String?      @map("dedupe_key")
  status            ReportStatus @default(PENDING)
  createdAt         DateTime     @default(now()) @map("created_at")
  resolvedAt        DateTime?    @map("resolved_at")
  resolverNote      String?      @map("resolver_note")
  reviewedByDiscordId String?   @map("reviewed_by_discord_id")
  reviewedAt        DateTime?    @map("reviewed_at")
  flagId            String?      @unique @map("flag_id") @db.Uuid

  reportedUser User @relation("ReportTarget", fields: [reportedUserId], references: [id], onDelete: Cascade)
  flag          Flag? @relation(fields: [flagId], references: [id], onDelete: SetNull)
  supportTicket SupportTicket?

  @@index([status, createdAt])
  @@index([reporterDiscordId, reportedUserId, guildId, createdAt(sort: Desc)])
  @@map("reports")
}

/// Guilds blocked from using the bot (ops — bot leaves on join when blacklisted).
model GuildBlacklist {
  guildId             String   @id @map("guild_id")
  reason              String?
  createdByDiscordId  String?  @map("created_by_discord_id")
  createdAt           DateTime @default(now()) @map("created_at")

  @@map("guild_blacklist")
}

model Server {
  id        String   @id @default(uuid()) @db.Uuid
  guildId   String   @unique @map("guild_id")
  config    Json     @default("{}")
  discordName       String?   @map("discord_name")
  iconHash          String?   @map("icon_hash")
  approximateMemberCount Int? @map("approximate_member_count")
  botJoinedAt       DateTime? @map("bot_joined_at")
  removedAt         DateTime? @map("removed_at")
  ownerDiscordId    String?   @map("owner_discord_id")
  vanityUrlCode     String?   @map("vanity_url_code")
  premiumTier       Int?      @map("premium_tier")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  entitlement GuildEntitlement?
  members     GuildMemberCache[]

  @@map("servers")
}

model GuildEntitlement {
  guildId              String          @id @map("guild_id")
  status               LicenseStatus   @default(INACTIVE)
  validFrom            DateTime        @map("valid_from")
  validUntil           DateTime?       @map("valid_until")
  stripeCustomerId     String?         @map("stripe_customer_id")
  stripeSubscriptionId String?       @map("stripe_subscription_id")
  planCode             String?         @map("plan_code")
  createdByDiscordId   String?         @map("created_by_discord_id")
  lastMemberSyncAt     DateTime?       @map("last_member_sync_at")
  memberSyncState      MemberSyncState @default(IDLE) @map("member_sync_state")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  server Server @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@map("guild_entitlements")
}

model GuildMemberCache {
  id              String   @id @default(uuid()) @db.Uuid
  guildId         String   @map("guild_id")
  discordUserId   String   @map("discord_user_id")
  username        String?  @map("username")
  globalName      String?  @map("global_name")
  avatarHash      String?  @map("avatar_hash")
  firstSeenAt     DateTime @default(now()) @map("first_seen_at")
  source          String   @default("SYNC") @map("source")

  server Server @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@unique([guildId, discordUserId])
  @@index([guildId])
  @@map("guild_member_cache")
}

model TrustedUser {
  id                 String   @id @default(uuid()) @db.Uuid
  discordUserId      String   @unique @map("discord_user_id")
  trustLevel         Int      @map("trust_level")
  grantedAt          DateTime @default(now()) @map("granted_at")
  grantedByDiscordId String?  @map("granted_by_discord_id")

  @@map("trusted_users")
}

/// Dashboard / platform RBAC (CHECKER | USER | ADMIN). TRUSTED is derived from TrustedUser.
model PlatformAccount {
  id             String       @id @default(uuid()) @db.Uuid
  discordUserId  String       @unique @map("discord_user_id")
  role           PlatformRole @default(CHECKER)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@map("platform_accounts")
}

model SupportTicket {
  id                     String              @id @default(uuid()) @db.Uuid
  reportId               String              @unique @map("report_id") @db.Uuid
  guildId                String?             @map("guild_id")
  reporterDiscordId      String              @map("reporter_discord_id")
  status                 SupportTicketStatus @default(OPEN)
  adminNote              String?             @map("admin_note")
  userMessage            String?             @map("user_message")
  evidenceLinks          Json                @default("[]") @map("evidence_links")
  assignedAdminDiscordId String?             @map("assigned_admin_discord_id")
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")

  report      Report                      @relation(fields: [reportId], references: [id], onDelete: Cascade)
  attachments SupportTicketAttachment[]

  @@index([reporterDiscordId, status])
  @@index([guildId, status])
  @@map("support_tickets")
}

model SupportTicketAttachment {
  id         String   @id @default(uuid()) @db.Uuid
  ticketId   String   @map("ticket_id") @db.Uuid
  storageKey String   @map("storage_key")
  mimeType   String   @map("mime_type")
  sizeBytes  Int      @map("size_bytes")
  createdAt  DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("support_ticket_attachments")
}

model AuditLog {
  id              String      @id @default(uuid()) @db.Uuid
  timestamp       DateTime    @default(now())
  actorDiscordId  String?     @map("actor_discord_id")
  actorKind       ActorKind   @default(USER) @map("actor_kind")
  action          AuditAction
  entityType      String      @map("entity_type")
  entityId        String      @map("entity_id")
  targetId        String?     @map("target_id")
  correlationId   String?     @map("correlation_id")
  metadata        Json        @default("{}")

  @@index([timestamp(sort: Desc)])
  @@index([action, timestamp(sort: Desc)])
  @@index([targetId, timestamp(sort: Desc)])
  @@index([correlationId, timestamp(sort: Desc)])
  @@map("audit_logs")
}

model OutboxEvent {
  id                  String       @id @default(uuid()) @db.Uuid
  type                String
  payload             Json
  correlationId       String?      @map("correlation_id")
  idempotencyKey      String?      @unique @map("idempotency_key")
  status              OutboxStatus @default(PENDING)
  attempts            Int          @default(0)
  nextRetryAt         DateTime?    @map("next_retry_at")
  lastError           String?      @map("last_error")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")
  dispatchedAt        DateTime?    @map("dispatched_at")
  processingStartedAt DateTime?    @map("processing_started_at")

  @@index([status, createdAt])
  @@index([status, nextRetryAt])
  @@index([status, processingStartedAt])
  @@map("outbox_events")
}

/// Audit trail for successfully fan-out events (idempotent consumer contract).
model ProcessedEvent {
  eventId    String   @id @map("event_id") @db.Uuid
  recordedAt DateTime @default(now()) @map("recorded_at")

  @@index([recordedAt(sort: Desc)])
  @@map("processed_events")
}

/// Rolling aggregates + manual /check counter; refreshed periodically by worker.
model PlatformStatsSnapshot {
  id                    String   @id @default("default")
  guildsActive          Int      @default(0) @map("guilds_active")
  trackedMemberDistinct Int      @default(0) @map("tracked_member_distinct")
  usersFlagged          Int      @default(0) @map("users_flagged")
  manualChecksTotal     Int      @default(0) @map("manual_checks_total")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("platform_stats_snapshot")
}

/// Stub for future FiveM / Minecraft / resell API keys
model ApiClient {
  id           String   @id @default(uuid()) @db.Uuid
  label        String
  hashedSecret String   @map("hashed_secret")
  scopes       Json     @default("[]")
  tenantId     String?  @map("tenant_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("api_clients")
}
