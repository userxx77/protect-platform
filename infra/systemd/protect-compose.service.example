# Optional: start Docker Compose project once at boot (after Docker is up).
# Adjust paths and User= before enabling.
#
#   sudo cp infra/systemd/protect-compose.service.example /etc/systemd/system/protect-compose.service
#   sudo nano /etc/systemd/system/protect-compose.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable protect-compose.service
#   sudo systemctl start protect-compose.service
#
# Containers already use restart: unless-stopped; this unit ensures the project is
# recreated if the daemon was down during boot.

[Unit]
Description=Protect platform Docker Compose
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/root/protect-platform
# User=root
# Group=root
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
