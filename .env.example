# Protect platform — environment template (Sentra production URLs as defaults).
# Copy to `.env` or run `./setup.sh` on a VPS (generates `.env` and starts Docker).
#
# Canonical names (setup prompts may use aliases: API_KEY → BOT_API_KEY, JWT_SECRET → AUTH_SECRET + DASHBOARD_JWT_SECRET, BOT_TOKEN → DISCORD_BOT_TOKEN).

# --- Runtime mode ---
# NODE_ENV=production
# LOG_LEVEL=info
# GIT_SHA=           # optional; shown in GET /internal/ops/overview
# WEB_URL / NEXTAUTH_URL = public dashboard (no trailing slash), e.g. https://dashboard.sentra.gg
# MAIN_SITE_URL = optional marketing apex (e.g. https://sentra.gg)

# --- PostgreSQL ---
POSTGRES_USER=protect
POSTGRES_PASSWORD=protect
POSTGRES_DB=protect
# Local dev (host Postgres):
DATABASE_URL=postgresql://protect:protect@localhost:5432/protect
# Docker Compose (from repo root): use hostnames postgres / redis, e.g.
# DATABASE_URL=postgresql://protect:protect@postgres:5432/protect

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379
# Optional password for Redis in Docker (see infra/redis/docker-entrypoint.sh):
# REDIS_PASSWORD=
# In Compose, REDIS_URL must match auth, e.g. redis://:secret@redis:6379

# --- Shared: internal API (bot + web in Docker Compose; do not use localhost here on VPS) ---
API_BASE_URL=http://api:3001

# --- API (@protect/api) ---
API_PORT=3001
# Public API URL (browser / OpenAPI links); production Sentra:
API_PUBLIC_URL=https://api.sentra.gg
BOT_API_KEY=change-me-long-random-string
DASHBOARD_JWT_SECRET=change-me-same-as-web-jwt-secret

# Optional: enable Swagger at `/docs`. In production, Swagger stays **off** unless you set SWAGGER_ENABLED=true (avoids exposing API shape on the public edge).
# SWAGGER_ENABLED=false

# If `platform_stats_snapshot` is missing: skip running refreshAggregates on first read (returns zeros; avoids heavy COUNT on large DBs). Worker should populate snapshot periodically.
# API_SNAPSHOT_REFRESH_ON_MISS=0

# Operator-only aggregate telemetry (`GET /v1/public/platform-stats`). Required for anonymous access to that route; ops-cli `sentra-tail` stats footer uses the same header.
# SENTRA_OPS_STATS_KEY=generate-long-random-string

# New guild (bot join): automatic trial length in days. `0` or unset = create INACTIVE entitlement only (community /report needs ACTIVE/TRIAL or allowlist).
# SENTRA_AUTO_TRIAL_DAYS=14

# Optional comma-separated guild IDs always treated as licensed (bypasses DB window check for community features).
# SENTRA_LICENSED_GUILD_IDS=123456789012345678,987654321098765432

# Single platform admin snowflake → API ADMIN + dashboard + bot `/sentra` platform + monitor (comma-separated if ever more than one).
ADMIN_DISCORD_IDS=1359945057876316241

# Browser CORS to the API (cross-origin XHR/fetch). The dashboard calls the API server-side by default, so production can leave this unset (no CORS = no browser access from random sites).
# CORS_ORIGINS=https://dashboard.sentra.gg,https://sentra.gg

# Flag scoring (5 tiers: CLEAN / WATCH / SUSPICIOUS / HIGH_RISK / CONFIRMED_CHEATER)
# FLAG_THRESHOLD_WATCH=1
# FLAG_THRESHOLD_SUSPICIOUS=3
# FLAG_THRESHOLD_HIGH_RISK=10
# FLAG_THRESHOLD_CONFIRMED=25
# FLAG_WEIGHT_MULTIPLIER=5
# FLAG_WEIGHT_CAP=50
# FLAG_WEIGHT_TIER_WATCH=1
# FLAG_WEIGHT_TIER_SUSPICIOUS=3
# FLAG_WEIGHT_TIER_HIGH_RISK=10
# FLAG_WEIGHT_TIER_CONFIRMED=25
# FLAG_DECAY_ENABLED=false
# USER_CACHE_TTL_SEC=120
# USER_NEGATIVE_CACHE_TTL_SEC=30

# Report anti-abuse (Redis)
# REPORT_DEDUPE_WINDOW_SEC=86400
# REPORT_COOLDOWN_SEC=120
# REPORT_MAX_PER_REPORTER_DAY=30

# API backpressure when outbox pending is high (see docs/runbooks/worker-recovery.md)
# API_OUTBOX_REJECT_THRESHOLD=5000

# Redis optional API mode (read-mostly without Redis; report intake may 503 — see docs)
# REDIS_OPTIONAL=true

# --- Worker (@protect/worker) ---
# WORKER_HEALTH_PORT=9090
# WORKER_INSTANCE_ID=
# PLATFORM_STATS_INTERVAL_MS=120000
# Full member cache refresh: outbox guild.members.sync for each DB-licensed guild, at most once per interval (ms). 0 = off. Default 24h in code.
# MEMBER_SYNC_INTERVAL_MS=86400000

# --- Discord bot (@protect/bot) ---
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
# Slash commands: global = every server sees `/sentra` (default). guild = dev-only, one guild + DISCORD_GUILD_ID.
# DISCORD_SLASH_SCOPE=global
# DISCORD_SLASH_SCOPE=guild
# DISCORD_GUILD_ID=(required when scope=guild)

# /sentra platform: same ADMIN_DISCORD_IDS as above (one entry in this file is enough for API + bot + web)

# Same Redis as API so the bot can subscribe to domain events (optional)
# REDIS_URL=redis://127.0.0.1:6379

# Bot HTTP probes (optional; liveness for orchestrators)
# BOT_HEALTH_PORT=9091

# Bot resilience / UX
# GUILD_COMMANDS_PER_MINUTE=30
# API_RETRY_MAX=3
# CIRCUIT_FAILURE_THRESHOLD=5
# CIRCUIT_OPEN_MS=30000
# SERVER_CONFIG_CACHE_TTL_MS=60000

# Optional: channel ID for admin feed (pending reports, guild join) — requires bot Send Messages
# DISCORD_ADMIN_FEED_CHANNEL_ID=

# WEB_URL is kept in sync with the dashboard URL (see setup.sh).
WEB_URL=https://dashboard.sentra.gg

# Main marketing site (optional; not used by core apps — for your reverse proxy / links)
MAIN_SITE_URL=https://sentra.gg

# --- Web dashboard (@protect/web) ---
# Public URL of the dashboard (no trailing slash). Required in production for OAuth; see GET /api/ready (checks.authPublicUrl).
NEXTAUTH_URL=https://dashboard.sentra.gg
# Optional override for Auth.js; Docker Compose defaults AUTH_URL to NEXTAUTH_URL when not set.
# AUTH_URL=https://dashboard.sentra.gg
AUTH_SECRET=generate-with-openssl-rand-base64-32
# Alias also accepted: NEXTAUTH_SECRET=
# Same value as JWT_SECRET if you use setup.sh (`JWT_SECRET` is also accepted as Auth.js secret).
# If you only set DASHBOARD_JWT_SECRET (legacy setups), the dashboard reuses it as the Auth.js secret when AUTH_SECRET is unset.
# OAuth includes scope `guilds` for Manage-Server guild suggestions on /dashboard/config
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Platform admin UI uses `ADMIN_DISCORD_IDS` from this same file (Compose loads one `.env` for api + web + bot).
NEXT_PUBLIC_API_URL=https://api.sentra.gg
# Apex → canonical dashboard (rebuild web after change — NEXT_PUBLIC_* inlined at build)
NEXT_PUBLIC_APEX_HOSTS=sentra.gg,www.sentra.gg
NEXT_PUBLIC_APP_ORIGIN=https://dashboard.sentra.gg

# --- Docker Compose (root docker-compose.yml) ---
# API_PUBLISH_PORT=3001
# WEB_PUBLISH_PORT=3000
# POSTGRES_PUBLISH_PORT=5432
# REDIS_PUBLISH_PORT=6379
# Post-deploy checks: ./validate-deployment.sh (see docs/runbooks/operations-and-recovery.md)

# --- Prisma seed (optional) ---
# Defaults in seed.ts match the platform admin below; override if you use different dev accounts.
# SEED_ADMIN_DISCORD_ID=1359945057876316241
# SEED_TRUSTED_DISCORD_ID=
